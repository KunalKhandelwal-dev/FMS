# ==========================================================
# FMS — FACULTY MANAGEMENT SYSTEM
# Environment Configuration Template
# Geeta University — Branding Department
# ==========================================================

# Environment Mode: development | test | production
NODE_ENV=development

# Application Identification & Public URL
APP_NAME="Faculty Management System"
APP_URL=http://localhost:3000

# Database Connection (MySQL / MariaDB Connection String)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://FMS_USER:FMS_PASSWORD@127.0.0.1:3306/fms_db"

# MariaDB Adapter Mode (Set to true when using @prisma/adapter-mariadb connection pool)
USE_PRISMA_MARIADB_ADAPTER=false

# Direct MariaDB Pool Configuration (Used when USE_PRISMA_MARIADB_ADAPTER=true)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=fms_user
DB_PASSWORD=
DB_NAME=fms_db

# Authentication Configuration
# Generate secure random secret with: openssl rand -base64 32
AUTH_SECRET=
AUTH_TRUST_HOST=true

# Initial Administrator Seed Configuration (Executed only via npm run db:seed)
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Media Storage Configuration (Local directory or persistent Hostinger mount)
MEDIA_STORAGE_ROOT=./storage/uploads
MAX_UPLOAD_SIZE_MB=25

# Logging & Observability (error | warn | info | debug)
LOG_LEVEL=info

